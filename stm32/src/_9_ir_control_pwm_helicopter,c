#define threshold 600
#define frame_timeout_ms 30
#define ARR 499
#define YAW_CCR_IDLE 85
#define IN1_PIN GPIO_PIN_0
#define IN2_PIN GPIO_PIN_1

volatile uint32_t t1 = 0;
volatile uint32_t t_now = 0;
volatile uint32_t pulse_width = 0;
volatile uint8_t bit_count = 0;
volatile uint64_t raw_data = 0;
volatile uint64_t frame_data = 0;
volatile uint8_t frame_ready = 0;
volatile uint8_t speed;
volatile uint8_t yaw = 17;
volatile uint8_t pitch = 34;
volatile uint8_t id1;
volatile uint16_t id2;
volatile uint32_t last_tick = 0;
volatile uint32_t last_print_tick = 0;

void HAL_TIM_IC_CaptureCallback(TIM_HandleTypeDef *htim)
{
    uint8_t bit;
    last_tick = HAL_GetTick();
    t_now = HAL_TIM_ReadCapturedValue(&htim2, TIM_CHANNEL_1);

    if (t1 == 0) {
        t1 = t_now;
        return;
    }

    if (t_now >= t1)
        pulse_width = t_now - t1;
    else
        pulse_width = (0xffffffff - t1) + t_now + 1;

    t1 = t_now;

    bit = (pulse_width > threshold) ? 1 : 0;
    raw_data = (raw_data << 1) | bit;
    bit_count++;

    if (bit_count >= 45) {
        frame_data = raw_data;
        bit_count = 0;
        frame_ready = 1;
        t1 = 0;
        raw_data = 0;
    }
}

uint16_t clamp(int value, int min, int max)
{
    if (value < min)
        return min;
    if (value > max)
        return max;
    return value;
}

uint16_t ir_to_ccr_pitch(uint8_t pitch_ir)
{
    uint16_t ccr;

    if (pitch_ir < 36) {
        ccr = (36 - pitch_ir) / 36.0f * (ARR + 1);
        HAL_GPIO_WritePin(GPIOC, IN1_PIN, GPIO_PIN_SET);
        HAL_GPIO_WritePin(GPIOC, IN2_PIN, GPIO_PIN_RESET);
    } else if (pitch_ir > 36) {
        ccr = (pitch_ir - 36) / 44.0f * (ARR + 1);
        HAL_GPIO_WritePin(GPIOC, IN1_PIN, GPIO_PIN_RESET);
        HAL_GPIO_WritePin(GPIOC, IN2_PIN, GPIO_PIN_SET);
    } else {
        ccr = 0;
        HAL_GPIO_WritePin(GPIOC, IN1_PIN, GPIO_PIN_RESET);
        HAL_GPIO_WritePin(GPIOC, IN2_PIN, GPIO_PIN_RESET);
    }

    return ccr;
}

void set_motor_a_b(uint16_t ccr_speed, uint16_t ccr_yaw, uint16_t ccr_pitch)
{
    int16_t yaw_offset = ccr_yaw - YAW_CCR_IDLE;
    uint16_t ccr_a = clamp(ccr_speed + yaw_offset, 0, ARR + 1);
    uint16_t ccr_b = clamp(ccr_speed - yaw_offset, 0, ARR + 1);
    uint16_t ccr_c = clamp(ccr_pitch, 0, ARR + 1);

    htim3.Instance->CCR1 = ccr_a;
    htim4.Instance->CCR1 = ccr_b;
    htim5.Instance->CCR1 = ccr_c;
}
